# Reference defaults for individual GitHub repository secrets (same names as below).
# APP_DOMAIN, DATABASE_URL, and OUTBOX_ENCRYPTION_KEY are required. Domain-derived
# values below are examples; the workflow derives them from APP_DOMAIN.
# Deployment writes /home/ubuntu/transpire/.env. Never commit real values.

ENVIRONMENT=production
DEBUG=false

# PostgreSQL on the same EC2 host (outside Docker): use host.docker.internal.
# PostgreSQL on a separate server: use that server's private IP instead.
DATABASE_URL=postgresql+asyncpg://transpire:<db-password>@host.docker.internal:5432/transpire

# Use the same public hostname as NEXT_PUBLIC_API_URL below.
# localhost is needed for the container health check.
ALLOWED_HOSTS=transpire.your-company.com,localhost,127.0.0.1
CORS_ORIGINS=https://transpire.your-company.com
CORS_ORIGIN_REGEX=
PUBLIC_APP_URL=https://transpire.your-company.com
PUBLIC_API_URL=https://transpire.your-company.com/api/v1

# The frontend reads the CSRF cookie by this exact name; do not change it.
SESSION_COOKIE_NAME=transpire_session
CSRF_COOKIE_NAME=transpire_csrf
SSO_SELECTION_COOKIE_NAME=transpire_sso_selection
SESSION_COOKIE_SECURE=true
SESSION_HOURS=12
REMEMBERED_SESSION_DAYS=30
PASSWORD_RESET_MINUTES=30
INVITATION_EXPIRY_HOURS=48

SIGN_IN_RATE_LIMIT=10
PASSWORD_RESET_RATE_LIMIT=5
AUTH_RATE_WINDOW_SECONDS=900
AUTH_RATE_BLOCK_SECONDS=900
ACCOUNT_LOCKOUT_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
WORKSPACE_SELECTION_MINUTES=5

# Generate once and keep it safe; losing it makes queued emails unreadable.
OUTBOX_ENCRYPTION_KEY=<generated-key>
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_SECONDS=30
OUTBOX_LEASE_SECONDS=300

# Keep console until SMTP is verified; then switch to smtp.
# IMDCAL relay: EMAIL_FROM_ADDRESS=transpire.app@imdcal.com,
# SMTP_HOST=imdcal-com.mail.protection.outlook.com, SMTP_PORT=25.
# Keep START_TLS=true, USE_TLS=false, and username/password empty for relay.
EMAIL_BACKEND=console
EMAIL_FROM_ADDRESS=no-reply@your-company.com
EMAIL_FROM_NAME=TRANSPIRE
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_START_TLS=true
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=15

# Microsoft Entra SSO (optional).
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
OIDC_STATE_MINUTES=10
SSO_RECOVERY_MINUTES=15

FX_API_BASE_URL=https://api.frankfurter.dev/v2
FX_CACHE_MINUTES=360

# Public frontend build settings. Never put secrets in NEXT_PUBLIC_* values.
NEXT_PUBLIC_API_URL=https://transpire.your-company.com/api/v1
NEXT_PUBLIC_CSRF_COOKIE_NAME=transpire_csrf
